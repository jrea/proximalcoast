# Proximalcoast environment variables.
# Copy to .env.local and fill in real values. Never commit real values.
# Variables are grouped by area; "required" means the app or the noted
# feature will not work without it.

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------

# Required. PostgreSQL connection string (production is Nile; the app
# expects the "main" schema via Prisma multi-schema).
DATABASE_URL=

# ---------------------------------------------------------------------------
# Auth (Better Auth)
# ---------------------------------------------------------------------------

# Required. Secret used to sign auth sessions/tokens.
BETTER_AUTH_SECRET=

# Required. Base URL the auth handler is served from
# (e.g. http://lvh.me:3000 in dev, https://www.proximalcoast.com in prod).
BETTER_AUTH_URL=

# Optional. Google OAuth credentials; Google sign-in is disabled without them.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---------------------------------------------------------------------------
# Site / host routing
# ---------------------------------------------------------------------------

# Required. Root domain the proxy (src/proxy.ts) uses to route subdomains
# to sites. Development uses lvh.me:3000 (so *.lvh.me resolves to localhost);
# production uses the real domain, proximalcoast.com.
ROOT_DOMAIN=

# ---------------------------------------------------------------------------
# Stripe (billing across jerkstore, bkd, overmake)
# ---------------------------------------------------------------------------

# Required. Stripe secret key (use test-mode keys locally).
STRIPE_SECRET_KEY=

# Required. Signing secret of the Stripe webhook endpoint
# (/api/webhooks/stripe); webhook events are rejected without it.
STRIPE_WEBHOOK_SECRET=

# Required. Stripe publishable key used by the client-side checkout forms.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Plan price IDs (see src/lib/billing/plans.ts). Required for the site(s)
# whose plans you sell; each site only needs its own.
# Jerkstore credit/subscription tiers:
NEXT_PUBLIC_STRIPE_PRICE_ID_SAVAGE=
NEXT_PUBLIC_STRIPE_PRICE_ID_ELITE=
NEXT_PUBLIC_STRIPE_PRICE_ID_FREE=
# BKD standard membership:
NEXT_PUBLIC_STRIPE_PRICE_ID_BKD=
# Overmake plans:
NEXT_PUBLIC_STRIPE_PRICE_ID_OVERMAKE_BUSHFIX=
NEXT_PUBLIC_STRIPE_PRICE_ID_OVERMAKE_DIYER=
NEXT_PUBLIC_STRIPE_PRICE_ID_OVERMAKE_SUCCESSION=
# Metered usage price (shared checkout helper):
NEXT_PUBLIC_STRIPE_PRICE_ID_METERED=

# ---------------------------------------------------------------------------
# AI
# ---------------------------------------------------------------------------

# Required for jerkstore roast generation. OpenAI API key.
OPENAI_API_KEY=

# ---------------------------------------------------------------------------
# Discord (jerkstore bot / interactions)
# ---------------------------------------------------------------------------

# Required for the jerkstore Discord integration.
DISCORD_APP_ID=
# Verifies signatures on the Discord interactions webhook.
DISCORD_PUBLIC_KEY=
# Bot token used by the command-registration script and bot features.
DISCORD_BOT_TOKEN=

# ---------------------------------------------------------------------------
# Analytics (optional)
# ---------------------------------------------------------------------------

# PostHog project key; analytics are disabled without it.
NEXT_PUBLIC_POSTHOG_KEY=
# PostHog host. Optional; defaults to https://us.i.posthog.com.
NEXT_PUBLIC_POSTHOG_HOST=
# Google Analytics measurement ID; GA is only loaded when set.
NEXT_PUBLIC_GA_ID=

# ---------------------------------------------------------------------------
# Scripts / local tooling only (not used by the running app)
# ---------------------------------------------------------------------------

# Set to 1 to let repo scripts run against a non-local DATABASE_URL
# (scripts/_env-guard.ts refuses otherwise).
ALLOW_NONLOCAL_DB=
# Reddit bot (scripts/reddit-bot): set to enable live posting instead of
# dry-run logging.
LIVE_POSTING=
# Test-user helper scripts (scripts/setup-test-user.ts,
# scripts/snapshot-test-user.ts): which account they create/snapshot.
TEST_USER_EMAIL=
SNAPSHOT_EMAIL=
# list-pis.ts helper: Stripe customer whose payment intents get listed.
STRIPE_CUSTOMER_ID=

# ---------------------------------------------------------------------------
# Provided by the platform — do NOT set these yourself
# ---------------------------------------------------------------------------

# NODE_ENV            set by Node/Next (development | production).
# VERCEL_ENV          set by Vercel (production | preview | development).
# VERCEL_URL          set by Vercel; the proxy only accepts it as a site
#                     host for preview deployments.
# VERCEL_BRANCH_URL   set by Vercel; same preview-host purpose.
