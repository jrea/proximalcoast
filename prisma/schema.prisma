generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["multiSchema"]
}

datasource db {
  provider = "postgresql"
  schemas  = ["main"]
}

model account {
  id                    String    @id
  userId                String
  accountId             String
  providerId            String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime? @db.Timestamp(6)
  refreshTokenExpiresAt DateTime? @db.Timestamp(6)
  scope                 String?
  password              String?
  createdAt             DateTime  @db.Timestamp(6)
  updatedAt             DateTime  @db.Timestamp(6)
  user                  user      @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([providerId, accountId])
  @@index([userId])
  @@schema("main")
}


model invitation {
  id             String       @id
  organizationId String
  email          String
  role           String?
  status         String
  expiresAt      DateTime     @db.Timestamp(6)
  inviterId      String
  createdAt      DateTime     @db.Timestamp(6)
  updatedAt      DateTime?    @db.Timestamp(6)
  user           user         @relation(fields: [inviterId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  organization   organization @relation(fields: [organizationId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([organizationId])
  @@index([inviterId])

  @@schema("main")
}

model member {
  id             String       @id
  organizationId String
  userId         String
  role           String
  createdAt      DateTime     @db.Timestamp(6)
  updatedAt      DateTime?    @db.Timestamp(6)
  organization   organization @relation(fields: [organizationId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  user           user         @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([organizationId])
  @@index([userId])

  @@schema("main")
}

model organization {
  id         String       @id
  name       String
  slug       String?      @unique
  logo       String?
  metadata   String?
  createdAt  DateTime     @db.Timestamp(6)
  updatedAt  DateTime?    @db.Timestamp(6)
  invitation invitation[]
  member     member[]
  apiKeys    ApiKey[]
  bkd_documents bkd_document[]
  activeSessions session[] @relation("SessionActiveOrganization")

  @@schema("main")
}

model session {
  id                   String   @id
  userId               String
  token                String   @unique
  expiresAt            DateTime @db.Timestamp(6)
  ipAddress            String?
  userAgent            String?
  createdAt            DateTime @db.Timestamp(6)
  updatedAt            DateTime @db.Timestamp(6)
  activeOrganizationId String?
  // Was a bare scalar with no FK, so sessions could point at deleted or
  // nonexistent organizations forever; now a real relation (SetNull).
  activeOrganization   organization? @relation("SessionActiveOrganization", fields: [activeOrganizationId], references: [id], onDelete: SetNull)
  user                 user     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([userId])

  @@schema("main")
}

model user {
  id            String       @id
  name          String
  // Nullable BY DESIGN for guest accounts only (isGuest = true, created
  // by the Jerkstore guest flow with no email). A DB CHECK constraint
  // (see migrations) enforces: email IS NOT NULL OR is_guest = true.
  // Do not "fix" this to required without breaking guest checkout.
  email         String?       @unique
  emailVerified Boolean
  image         String?
  createdAt     DateTime     @db.Timestamp(6)
  updatedAt     DateTime     @db.Timestamp(6)
  stripeCustomerId   String? @unique
  username           String? @unique
  isGuest            Boolean @default(false)
  account       account[]
  invitation    invitation[]
  member        member[]
  session       session[]
  jerkstore_insult jerkstore_insult[]
  subscriptions    user_subscription[]
  overmake_estimate overmake_estimate[]
  apiKeys          ApiKey[]
  bkd_documents    bkd_document[]
  jerkstore_credit_purchases jerkstore_credit_purchase[]
  stripe_session_claims stripe_session_claim[]
  preferences      Json?
  credits          Int      @default(3)
  phone            String?

  @@schema("main")
}

model user_subscription {
  id                   String   @id @default(uuid())
  userId               String
  siteSlug             String   // e.g., "jerkstore"
  stripeSubscriptionId String   @unique
  // Vocabularies enforced by DB CHECK constraints (see migrations):
  // status: every status Stripe can deliver; plan/upcomingPlan: the plan
  // names from src/lib/billing/plans.ts. Update all three together.
  status               String   // active, trialing, canceled, past_due, incomplete, incomplete_expired, unpaid, paused
  plan                 String   @default("standard") // standard, elite, savage, trial, bushfix, diyer, succession
  upcomingPlan         String?  // Plan scheduling to switch to at period end
  cancelAtPeriodEnd    Boolean  @default(false)
  priceAmount          Int?     // Amount in cents
  priceCurrency        String?  // e.g., "usd"
  expiresAt            DateTime @db.Timestamp(6)
  createdAt            DateTime @default(now()) @db.Timestamp(6)
  updatedAt            DateTime @updatedAt @db.Timestamp(6)
  user                 user     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, siteSlug])
  @@schema("main")
}


model verification {
  id         String    @id
  identifier String
  value      String
  expiresAt  DateTime  @db.Timestamp(6)
  createdAt  DateTime? @db.Timestamp(6)
  updatedAt  DateTime? @db.Timestamp(6)

  @@unique([identifier, value])
  @@schema("main")
}

model ApiKey {
  id        String   @id @default(cuid())
  key       String   @unique // Store as a hashed value for security
  name      String   // e.g., "Reddit Bot"
  userId    String
  user      user     @relation(fields: [userId], references: [id], onDelete: Cascade)
  organizationId String?
  organization   organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  lastUsedAt DateTime? @db.Timestamp(6)
  // Lifecycle: keys expire (new keys default to +1 year at creation) and
  // revocation is a state, not a deletion, so the audit trail survives.
  // All verifiers go through src/lib/api-keys.ts (verifyApiKey).
  expiresAt DateTime? @db.Timestamp(6)
  revokedAt DateTime? @db.Timestamp(6)
  createdAt DateTime @default(now()) @db.Timestamp(6)

  @@index([userId])
  @@index([organizationId])
  @@schema("main")
}


model jerkstore_insult {
  id               String   @id @default(uuid())
  content          String
  topic            String?
  language         String?
  promptTokens     Int      @default(0)
  completionTokens Int      @default(0)
  userId           String
  user             user     @relation(fields: [userId], references: [id], onDelete: Cascade)
  isEmail          Boolean  @default(false)
  heatLevel        String   @default("spicy")
  createdAt        DateTime @default(now()) @db.Timestamp(6)
  weight           Int      @default(0)
  safe_insult      jerkstore_insult_safe[]

  @@index([userId])
  @@schema("main")
}

// One immutable receipt per new Jerkstore credit purchase. Checkout and
// webhook fulfillment use the same ID, so retries cannot add credits twice.
model jerkstore_credit_purchase {
  paymentIntentId String @id
  userId String
  credits Int
  createdAt DateTime @default(now()) @db.Timestamp(6)
  // NoAction is DELIBERATE here (unlike the auth models): receipts are
  // the money ledger and must never be cascade-deleted with a user.
  user user @relation(fields: [userId], references: [id], onDelete: NoAction)

  @@index([userId])
  @@schema("main")
}

model jerkstore_insult_safe {
  id        String           @id @default(uuid())
  insultId  String
  insult    jerkstore_insult @relation(fields: [insultId], references: [id], onDelete: Cascade)
  createdAt DateTime         @default(now()) @db.Timestamp(6)

  @@index([insultId])
  @@schema("main")
}

model overmake_estimate {
  id        String   @id @default(uuid())
  task      String
  level     Int
  proposal  String
  bom       String // Stored as JSON string
  userId    String
  user      user     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @db.Timestamp(6)

  @@index([userId])
  @@schema("main")
}

model jerkstore_ip_tracking {
  ip        String   @id
  count     Int      @default(0)
  createdAt DateTime @default(now()) @db.Timestamp(6)
  updatedAt DateTime @updatedAt @db.Timestamp(6)

  @@schema("main")
}

model bkd_document {
  id        String   @id @default(uuid())
  userId    String   // Required: Who uploaded it
  organizationId String   // Required: Who owns it
  filename  String
  s3Key     String   @unique
  status    String   // PENDING, SIGNED (vocabulary enforced by DB CHECK in migrations)
  config    Json     // { x, y, width, height, page }
  hash      String?  @unique // Cryptographic SHA-256 integrity hash
  auditLog  Json?    // Historical lifecycle events
  signerEmail String? // Identified signer
  signerName  String? // Typed signature name
  signatureFont String? // Selected signature font
  createdAt DateTime @default(now())
  signedAt  DateTime?

  // Restrict, NOT Cascade: these rows are signing evidence (hash +
  // auditLog) and the only index to the S3 objects. Deleting a user or
  // org must be blocked until documents are explicitly archived —
  // previously one user deletion wiped an org's signed documents.
  user           user         @relation(fields: [userId], references: [id], onDelete: Restrict)
  organization   organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@index([userId])
  @@index([organizationId])
  @@schema("main")
}

// Single-use claims for BKD guest checkout session IDs. complete-account
// inserts the session ID here before linking anything; the PK makes a
// session ID usable exactly once, even under concurrent requests.
model stripe_session_claim {
  sessionId String   @id
  userId    String
  createdAt DateTime @default(now()) @db.Timestamp(6)
  user      user     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@schema("main")
}
