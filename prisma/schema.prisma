generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["multiSchema"]
}

datasource db {
  provider = "postgresql"
  schemas  = ["main"]
}

model account {
  id                    String    @id
  userId                String
  accountId             String
  providerId            String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime? @db.Timestamp(6)
  refreshTokenExpiresAt DateTime? @db.Timestamp(6)
  scope                 String?
  password              String?
  createdAt             DateTime  @db.Timestamp(6)
  updatedAt             DateTime  @db.Timestamp(6)
  user                  user      @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([providerId, accountId])
  @@schema("main")
}


model invitation {
  id             String       @id
  organizationId String
  email          String
  role           String?
  status         String
  expiresAt      DateTime     @db.Timestamp(6)
  inviterId      String
  createdAt      DateTime     @db.Timestamp(6)
  updatedAt      DateTime?    @db.Timestamp(6)
  user           user         @relation(fields: [inviterId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  organization   organization @relation(fields: [organizationId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@schema("main")
}

model member {
  id             String       @id
  organizationId String
  userId         String
  role           String
  createdAt      DateTime     @db.Timestamp(6)
  updatedAt      DateTime?    @db.Timestamp(6)
  organization   organization @relation(fields: [organizationId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  user           user         @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@schema("main")
}

model organization {
  id         String       @id
  name       String
  slug       String?      @unique
  logo       String?
  metadata   String?
  createdAt  DateTime     @db.Timestamp(6)
  updatedAt  DateTime?    @db.Timestamp(6)
  invitation invitation[]
  member     member[]
  apiKeys    ApiKey[]
  bkd_documents bkd_document[]

  @@schema("main")
}

model session {
  id                   String   @id
  userId               String
  token                String   @unique
  expiresAt            DateTime @db.Timestamp(6)
  ipAddress            String?
  userAgent            String?
  createdAt            DateTime @db.Timestamp(6)
  updatedAt            DateTime @db.Timestamp(6)
  activeOrganizationId String?
  user                 user     @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@schema("main")
}

model user {
  id            String       @id
  name          String
  email         String?       @unique
  emailVerified Boolean
  image         String?
  createdAt     DateTime     @db.Timestamp(6)
  updatedAt     DateTime     @db.Timestamp(6)
  stripeCustomerId   String? @unique
  username           String? @unique
  isGuest            Boolean @default(false)
  account       account[]
  invitation    invitation[]
  member        member[]
  session       session[]
  jerkstore_insult jerkstore_insult[]
  subscriptions    user_subscription[]
  overmake_estimate overmake_estimate[]
  apiKeys          ApiKey[]
  bkd_documents    bkd_document[]
  hanko_documents  hanko_document[]
  preferences      Json?
  credits          Int      @default(3)
  phone            String?

  @@schema("main")
}

model user_subscription {
  id                   String   @id @default(uuid())
  userId               String
  siteSlug             String   // e.g., "jerkstore"
  stripeSubscriptionId String   @unique
  status               String   // active, trialing, canceled, etc.
  plan                 String   @default("standard") // standard, elite, savage
  upcomingPlan         String?  // Plan scheduling to switch to at period end
  cancelAtPeriodEnd    Boolean  @default(false)
  priceAmount          Int?     // Amount in cents
  priceCurrency        String?  // e.g., "usd"
  expiresAt            DateTime @db.Timestamp(6)
  createdAt            DateTime @default(now()) @db.Timestamp(6)
  updatedAt            DateTime @updatedAt @db.Timestamp(6)
  user                 user     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, siteSlug])
  @@schema("main")
}


model verification {
  id         String    @id
  identifier String
  value      String
  expiresAt  DateTime  @db.Timestamp(6)
  createdAt  DateTime? @db.Timestamp(6)
  updatedAt  DateTime? @db.Timestamp(6)

  @@unique([identifier, value])
  @@schema("main")
}

model ApiKey {
  id        String   @id @default(cuid())
  key       String   @unique // Store as a hashed value for security
  name      String   // e.g., "Reddit Bot"
  userId    String
  user      user     @relation(fields: [userId], references: [id], onDelete: Cascade)
  organizationId String?
  organization   organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  lastUsedAt DateTime? @db.Timestamp(6)
  createdAt DateTime @default(now()) @db.Timestamp(6)

  @@schema("main")
}


model jerkstore_insult {
  id               String   @id @default(uuid())
  content          String
  topic            String?
  language         String?
  promptTokens     Int      @default(0)
  completionTokens Int      @default(0)
  userId           String
  user             user     @relation(fields: [userId], references: [id], onDelete: Cascade)
  isEmail          Boolean  @default(false)
  heatLevel        String   @default("spicy")
  createdAt        DateTime @default(now()) @db.Timestamp(6)
  weight           Int      @default(0)
  safe_insult      jerkstore_insult_safe[]

  @@schema("main")
}

model jerkstore_insult_safe {
  id        String           @id @default(uuid())
  insultId  String
  insult    jerkstore_insult @relation(fields: [insultId], references: [id], onDelete: Cascade)
  createdAt DateTime         @default(now()) @db.Timestamp(6)

  @@schema("main")
}

model overmake_estimate {
  id        String   @id @default(uuid())
  task      String
  level     Int
  proposal  String
  bom       String // Stored as JSON string
  userId    String
  user      user     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @db.Timestamp(6)

  @@schema("main")
}

model jerkstore_ip_tracking {
  ip        String   @id
  count     Int      @default(0)
  createdAt DateTime @default(now()) @db.Timestamp(6)
  updatedAt DateTime @updatedAt @db.Timestamp(6)

  @@schema("main")
}

model bkd_document {
  id        String   @id @default(uuid())
  userId    String   // Required: Who uploaded it
  organizationId String   // Required: Who owns it
  filename  String
  s3Key     String
  status    String   // PENDING, SIGNED
  config    Json     // { x, y, width, height, page }
  hash      String?  // Cryptographic SHA-256 integrity hash
  auditLog  Json?    // Historical lifecycle events
  signerEmail String? // Identified signer
  signerName  String? // Typed signature name
  signatureFont String? // Selected signature font
  createdAt DateTime @default(now())
  signedAt  DateTime?

  user           user         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization   organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@schema("main")
}


model hanko_document {
  id            String   @id @default(uuid())
  userId        String
  filename      String
  s3Key         String
  status        String
  config        Json
  documentHash  String?
  sealedHash    String?
  signerEmail   String?
  signerName    String?
  signatureFont String?
  createdAt     DateTime @default(now()) @db.Timestamp(6)
  signedAt      DateTime?

  user          user               @relation(fields: [userId], references: [id], onDelete: Cascade)
  signEvents    hanko_sign_event[]
  consentRecord hanko_consent_record?

  @@schema("main")
}

model hanko_sign_event {
  id           String   @id @default(uuid())
  documentId   String
  eventType    String
  signerEmail  String
  signerId     String?
  timestamp    DateTime @default(now()) @db.Timestamp(6)
  ipAddress    String
  userAgent    String
  geoCountry   String?
  geoCity      String?
  documentHash String
  sequenceNum  Int
  metadata     Json?

  document     hanko_document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@schema("main")
}

model hanko_consent_record {
  id           String   @id @default(uuid())
  documentId   String   @unique
  signerEmail  String
  timestamp    DateTime @default(now()) @db.Timestamp(6)
  ipAddress    String
  userAgent    String
  viewportSize String
  browserName  String?

  document     hanko_document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@schema("main")
}
