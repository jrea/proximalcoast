{
  "name": "proximalcoast",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "preinstall": "npx only-allow pnpm",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint",
    "postinstall": "prisma generate",
    "stripe-listen": "stripe listen --forward-to localhost:3000/api/webhooks/stripe",
    "discord:register": "ts-node --skip-project src/app/sites/jerkstore/discord/register-commands.ts",
    "dev:stripe": "concurrently \"next dev\" \"pnpm stripe-listen\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:baseline": "prisma migrate resolve --applied 20261013000000_baseline_original_schema"
  },
